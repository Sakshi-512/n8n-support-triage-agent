    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let raw = $json.text || '';\nraw = raw.replace(/```json|```/g, '').trim();\n\nlet ai = null;\ntry {\n  ai = JSON.parse(raw);\n} catch (e) {\n  ai = null;\n}\n\nconst webhook = $('Webhook').item.json.body;\nconst valid = ai && ai.category && ai.draft_reply && ai.confidence;\n\nreturn {\n  json: {\n    message_id: webhook.id,\n    customer_message: webhook.message,\n    category: valid ? ai.category : 'unknown',\n    draft_reply: valid ? ai.draft_reply : '',\n    confidence: valid ? ai.confidence : 'low',\n    needs_human: valid ? (ai.needs_human === true || ai.confidence !== 'high') : true,\n    parse_error: !valid,\n    raw_ai_output: raw\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
